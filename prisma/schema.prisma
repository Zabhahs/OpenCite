// OpenCITE — Prisma Schema
// Provider: Vercel Postgres (PostgreSQL)
// Auth adapter: @auth/prisma-adapter (Auth.js v5)
// Phase 4 hook: agent_wallet_address (SIWE / Base L2)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")      // pgBouncer pooler — runtime
  directUrl = env("POSTGRES_URL_NON_POOLING") // direct connection — migrations only
}

// ─── Core user record ────────────────────────────────────────────────────────

model User {
  id                   String    @id @default(uuid()) @map("internal_id")
  email                String?   @unique
  emailVerified        DateTime?
  name                 String?
  image                String?

  // Phase 3 hook — Stripe billing
  stripe_customer_id   String?   @unique

  // Phase 4 hook — SIWE / Base L2 autonomous agent auth
  agent_wallet_address String?   @unique

  // v0.48 three-bucket balance (billing.js preAuthorize spends allowance → purchased → metered):
  //   allowance_credits — the plan's monthly allowance; RESET to the grant each period, never rolls over
  //   total_credits     — PURCHASED credits (packs); never expire. v0.48: seeded at 0 (no free API credits)
  allowance_credits    Decimal   @default(0) @db.Decimal(12, 4)
  total_credits        Decimal   @default(0) @db.Decimal(12, 4)

  // Phase 3 — billing tier + recurring grant tracking (WS3)
  plan                 String    @default("free")  // PLANS id (plans.js): free|student|pro|machine|api
  is_student_verified  Boolean   @default(false)   // v0.47: Student is honor-system; column retained, never set
  student_verified_at  DateTime?
  credits_period       String?   // YYYY-MM of the last monthly grant (top-up idempotency)
  stripe_subscription_id String? @unique           // active Stripe subscription, if any
  // v0.48 metered (postpaid) plan state — see plans.js `api`
  subscription_status  String?                     // Stripe subscription status as last seen by the webhook
  metered_period       String?                     // YYYY-MM the metered_usage counter belongs to
  metered_usage        Decimal   @default(0) @db.Decimal(12, 4)   // units spent on the metered bucket this period
  metered_unreported   Decimal   @default(0) @db.Decimal(12, 4)   // units not yet reported to the Stripe meter
  metered_cap_usd      Decimal   @default(25) @db.Decimal(10, 2)  // user-set monthly spend cap (D-12)
  pack_purchased_at    DateTime?                   // v0.48 (leak L2): set on first pack; keeps `machine` after a sub ends

  // Flexible demographic / preference blob (analytics, Phase 5)
  demographics         Json?

  // User API keys + custom journals — AES-256-GCM encrypted blob (v.15)
  settings             Json?

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Auth.js required relations
  accounts             Account[]
  sessions             Session[]

  // Phase 1 — sync relations
  search_history       search_history[]
  library_items        library_items[]

  // Phase 3 — API billing (WS3)
  api_keys             ApiKey[]
  // v0.48 — append-only money journal
  credit_events        CreditEvent[]

  @@map("users")
}

// ─── Auth.js required models ─────────────────────────────────────────────────
// Do not rename fields — @auth/prisma-adapter expects this exact shape.

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Phase 1 — Search history ────────────────────────────────────────────────

model search_history {
  id      String @id @default(uuid())
  user_id String
  query   String
  ts      BigInt

  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, query], name: "user_id_query")
  @@map("search_history")
}

// ─── Phase 1 — Library items ─────────────────────────────────────────────────

model library_items {
  id          String @id @default(uuid())
  user_id     String
  library_key String
  result      Json
  saved_at    BigInt

  user        User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, library_key], name: "user_id_library_key")
  @@map("library_items")
}

// ─── Phase 3 — API billing (WS3) ─────────────────────────────────────────────
// Server-authoritative billing state lives in first-class columns (NOT the
// encrypted settings blob) so it's queryable: filter by plan, sum credits,
// join keys. Credits themselves stay on User.total_credits.

model ApiKey {
  id           String    @id @default(uuid())
  key_hash     String    @unique            // sha256(pepper + key); plaintext NEVER stored
  key_prefix   String                       // first ~12 chars, for display only
  user_id      String
  plan         String    @default("free")   // vestigial — entitlement comes from User.plan (apiAuth.js)
  revoked      Boolean   @default(false)
  created_at   DateTime  @default(now())
  last_used_at DateTime?
  // v0.48: human label; the OAuth client that minted this key (Phase 3 remote MCP) or null
  label           String?
  oauth_client_id String?

  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  usage        ApiUsage[]

  @@index([user_id])
  @@index([oauth_client_id])
  @@map("api_keys")
}

// ─── v0.48 — append-only money journal (sprint v0.45 T1 design) ──────────────
// Every balance mutation writes one row in the SAME transaction as the balance write.
// Evidence, not balance: users.allowance_credits / total_credits stay authoritative and no
// read path ever derives a balance from events. The three *_delta columns record which
// bucket(s) moved; `amount` is the signed total.
model CreditEvent {
  id              String   @id @default(uuid())
  user_id         String
  key_id          String?                                // api_keys.id that spent it (null for sessions / grants)
  kind            String                                 // preauth | settle | refund | reconcile | grant | purchase | clawback | report | trial
  amount          Decimal  @db.Decimal(12, 4)            // signed total delta (preauth < 0)
  allowance_delta Decimal  @default(0) @db.Decimal(12, 4)
  purchased_delta Decimal  @default(0) @db.Decimal(12, 4)
  metered_delta   Decimal  @default(0) @db.Decimal(12, 4)
  band            String?                                // coverage band on settle
  endpoint        String?                                // search | citations | ids | verify | works | works_meta
  request_id      String?                                // pairs preauth ↔ settle/refund/reconcile
  source          String?                                // Stripe event id / meter identifier / sweep run id
  created_at      DateTime @default(now())

  user            User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@index([request_id])
  @@index([kind, created_at])
  @@map("credit_events")
}

// ─── v0.48 — verify trial counter (api/_shared/trial.js) ─────────────────────
model TrialUsage {
  identity   String                 // ip:<addr> | user:<id>
  day        DateTime @db.Date
  refs       Int      @default(0)
  updated_at DateTime @default(now())

  @@id([identity, day])
  @@map("trial_usage")
}

// Optional per-day usage rollup for analytics (billing truth is the credit ledger,
// not this table). One row per (key, day).
model ApiUsage {
  id      String  @id @default(uuid())
  key_id  String?                      // nullable: orphan rows survive key deletion (F-502)
  key     ApiKey? @relation(fields: [key_id], references: [id], onDelete: SetNull)
  day     String  // YYYY-MM-DD (UTC)
  count   Int     @default(0)

  @@unique([key_id, day], name: "key_id_day")
  @@index([key_id])
  @@map("api_usage")
}

// Durable Stripe webhook idempotency (R11). A unique insert on the event id is
// bulletproof — unlike a KV claim, it can't double-grant if the cache is down.
model ProcessedEvent {
  event_id     String   @id // Stripe event.id
  type         String
  processed_at DateTime @default(now())

  @@map("processed_events")
}

// ─── F1 (v0.33) — Gold-set relevance labels for regression testing ────────────
// Admin console: store expected-good rankings for queries. Used by F2 harness to
// compute nDCG@10, MRR, recall metrics and detect scoring regressions.
// grade: 0=irrelevant, 1=marginal, 2=relevant, 3=perfect.
model relevance_labels {
  id         Int       @id @default(autoincrement())
  query      String                           // the search query
  doi        String                           // the result's DOI (or title fingerprint if no DOI)
  grade      Int       @default(0)            // relevance: 0|1|2|3
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  @@index([query, grade])
  @@map("relevance_labels")
}

// ─── v0.50 — Search data capture (queries · results · signals) ───────────────
// Every search (web beacon, API, MCP) and every interaction with a result is captured for
// ranking research. Store REFERENCES, never cards: `works` holds each distinct paper once
// (keyed by publicResult.anonymizeId), `search_events` packs the displayed page as parallel
// arrays of works.id / adapter ordinal / score, `search_signals` records what the user — or
// an agent, via its follow-on call — did with a result. Written by api/_shared/searchLog.js
// through raw SQL (multi-row upsert + array columns); these models exist for schema parity.
// Retention: indefinite. Account deletion de-identifies (user_id → NULL), never deletes.

model works {
  id         Int      @id @default(autoincrement())
  oc_id      String   @unique                     // anonymizeId(record)
  doi        String?
  source     String                               // adapter id of FIRST sighting (UNSEEN = machine stub)
  title      String?
  authors    String[]                             // display names only
  year       Int?     @db.SmallInt
  venue      String?                              // journal | publisher
  type       String?
  abstract   String?                              // what a reranker trains on — kept
  keywords   String[]
  url        String?
  is_oa      Boolean?
  cited_by   Int?
  first_seen DateTime @default(now()) @db.Timestamptz(3)
  seen_n     Int      @default(1)                 // pages this work has appeared on

  signals    search_signals[]

  @@index([doi])
  @@map("works")
}

model search_events {
  id          BigInt    @id @default(autoincrement())
  ts          DateTime  @default(now()) @db.Timestamptz(3)
  query       String                              // raw, as typed / as sent
  terms       String[]                            // ';' multi-term split
  surface     Int       @db.SmallInt              // 0 web · 1 api · 2 mcp · 3 admin-console
  user_id     String?                             // session user / key owner; NULL anon
  key_id      String?                             // api_keys.id when keyed
  plan        String?
  actor       Bytes?                              // sha256(ip+ua+daily salt)[:8] — anon session grouping
  ip_hash     Bytes?                              // sha256(ip+pepper)[:8]
  ua          String?
  client      String?                             // X-OpenCITE-Client (opencite-mcp/x.y) | "browser"
  tool        String?                             // X-OpenCITE-Tool (search_papers …) for MCP calls
  settings    Json?                               // request / UI settings snapshot
  experiment  String?
  eligible    String[]                            // adapter ids asked
  failed      String[]                            // adapter ids errored / timed out / circuit-open
  coverage    String?
  n_raw       Int?      @db.SmallInt
  n_dedup     Int?      @db.SmallInt
  n_returned  Int?      @db.SmallInt
  latency_ms  Int?
  cache_hit   Boolean   @default(false)
  page        Int       @default(0) @db.SmallInt  // load-more depth (web)
  dwell_ms    Int?                                // time on the results page before next search / leave
  top         Int[]                               // works.id in FINAL displayed order
  top_src     Int[]                               // adapter ordinal per position (adapters/_shared/ordinals.js)
  scores      Int[]                               // score ×1000 per position (_sim | native) — empty when none

  signals     search_signals[]

  @@index([ts])
  @@index([user_id])
  @@map("search_events")
}

model search_signals {
  id       BigInt   @id @default(autoincrement())
  event_id BigInt?                                // NULL for machine refs we never surfaced
  work_id  Int
  rank     Int      @db.SmallInt                  // 0-based displayed position; -1 when unmatched
  action   Int      @db.SmallInt                  // searchLog.SIGNAL codes
  ts       DateTime @default(now()) @db.Timestamptz(3)
  meta     Json?

  event    search_events? @relation(fields: [event_id], references: [id], onDelete: Cascade)
  work     works          @relation(fields: [work_id], references: [id])

  @@index([event_id])
  @@index([work_id])
  @@map("search_signals")
}
