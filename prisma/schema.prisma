// OpenCITE — Prisma Schema
// Provider: Vercel Postgres (PostgreSQL)
// Auth adapter: @auth/prisma-adapter (Auth.js v5)
// Phase 4 hook: agent_wallet_address (SIWE / Base L2)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")      // pgBouncer pooler — runtime
  directUrl = env("POSTGRES_URL_NON_POOLING") // direct connection — migrations only
}

// ─── Core user record ────────────────────────────────────────────────────────

model User {
  id                   String    @id @default(uuid()) @map("internal_id")
  email                String?   @unique
  emailVerified        DateTime?
  name                 String?
  image                String?

  // Phase 3 hook — Stripe billing
  stripe_customer_id   String?   @unique

  // Phase 4 hook — SIWE / Base L2 autonomous agent auth
  agent_wallet_address String?   @unique

  // Credits: seeded at 10 on signup via @default
  total_credits        Decimal   @default(10) @db.Decimal(12, 4)

  // Flexible demographic / preference blob (analytics, Phase 5)
  demographics         Json?

  // User API keys + custom journals — AES-256-GCM encrypted blob (v.15)
  settings             Json?

  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Auth.js required relations
  accounts             Account[]
  sessions             Session[]

  // Phase 1 — sync relations
  search_history       search_history[]
  library_items        library_items[]

  @@map("users")
}

// ─── Auth.js required models ─────────────────────────────────────────────────
// Do not rename fields — @auth/prisma-adapter expects this exact shape.

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Phase 1 — Search history ────────────────────────────────────────────────

model search_history {
  id      String @id @default(uuid())
  user_id String
  query   String
  ts      BigInt

  user    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, query], name: "user_id_query")
  @@map("search_history")
}

// ─── Phase 1 — Library items ─────────────────────────────────────────────────

model library_items {
  id          String @id @default(uuid())
  user_id     String
  library_key String
  result      Json
  saved_at    BigInt

  user        User   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, library_key], name: "user_id_library_key")
  @@map("library_items")
}
