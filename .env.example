# OpenCITE — Environment Variables
# Copy to .env.local for local dev. Never commit .env.local.
# Vercel: add all vars via dashboard → Project Settings → Environment Variables.

# ─── Supabase / Prisma ────────────────────────────────────────────────────────
# Get both from: Supabase dashboard → Project Settings → Database → Connection string
# These EXACT names are read by prisma/schema.prisma and scripts/migrate.mjs —
# any other name (e.g. DATABASE_URL) yields Prisma P1013 on migrate/generate.
#
# POSTGRES_PRISMA_URL      — Transaction pooler (port 6543, pgBouncer). Prisma runtime.
#                            Append ?pgbouncer=true to disable prepared statements.
# POSTGRES_URL_NON_POOLING — Direct connection (port 5432). `prisma migrate` (DDL) only.

POSTGRES_PRISMA_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ─── Auth.js ──────────────────────────────────────────────────────────────────
# AUTH_SECRET: generate with `openssl rand -base64 32`

AUTH_SECRET=""

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
# Authorised redirect URI: https://opencite.app/api/auth/callback/google

AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Apple / Microsoft OAuth — quarantined v0.41 (docs/wiki/99-Archive/_quarantine/oauth-apple-microsoft.md); no env vars needed.

# ─── Auth loopback URL ───────────────────────────────────────────────────────
# Canonical origin Auth.js uses (and getSession pins the loopback session fetch to).
# Set to the deployment's own origin; on preview, the preview URL.
AUTH_URL="https://citation.today"

# ─── Crypto — REQUIRED in production ─────────────────────────────────────────
# SETTINGS_ENCRYPTION_KEY: 32-byte hex (64 chars) for the AES-256-GCM settings blob.
#   Generate: openssl rand -hex 32. Must not change once settings rows exist.
# API_KEY_PEPPER: mixed into the one-way API-key hash so a DB leak can't be brute-forced
#   against the known oc_live_<...> format. REQUIRED in production — the app throws at
#   startup if unset (findings F-404/F-509). Generate: openssl rand -hex 32.
#   ONE-WAY: must NOT change after keys are issued — rotating it invalidates every key.
SETTINGS_ENCRYPTION_KEY=""
API_KEY_PEPPER=""

# OPENCITE_API_KEY: optional break-glass master key → admin plan (unmetered, all-tier).
# OPENCITE_API_KEY=""
# VITE_ADMIN_EMAILS: comma-separated admin allowlist (gates the admin console + debug=1).
# VITE_ADMIN_EMAILS="you@example.com"

# ─── KV / Upstash (rate limiter + cache) ─────────────────────────────────────
# Provide either the Vercel KV pair or the Upstash pair. Fail-open if unset.
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# ─── Backend-injected source keys (v0.34) ────────────────────────────────────
# Keyed sources auto-drop from eligibility when their var is unset (no false coverage).
DPLA_API_KEY=""
SMITHSONIAN_API_KEY=""
# EUROPEANA_API_KEY: project key (europeana.eu/api); serverKeys.js injects it into the paid fan-out. Without it
# Europeana silently drops out of the paid tier (a per-user client key remains a browser fallback).
EUROPEANA_API_KEY=""
# OPENCITE_MAILTO: contact email sent as the polite-pool identity to OpenAlex/Crossref/NCBI. REQUIRED in prod —
# without it Crossref drops the server to 1 req/s and OpenAlex to the anonymous pool.
OPENCITE_MAILTO="ops@citation.today"
# OPENALEX_API_KEY: REQUIRED for the paid API. OpenAlex bills $0.001 per search call (since Feb 2026); keyless
# callers share a $0.10/day budget, a free key gets $1/day. Register at openalex.org/settings/api.
OPENALEX_API_KEY=""
# NCBI_API_KEY: free at ncbi.nlm.nih.gov/account — lifts E-utilities from 3 to 10 req/s.
NCBI_API_KEY=""

# ─── Stripe (billing) ────────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# Subscription + pack Price ids (Stripe dashboard → Products):
# STRIPE_PRICE_STUDENT=""
# STRIPE_PRICE_PRO=""
# STRIPE_PRICE_PACK_10K=""
# STRIPE_PRICE_PACK_60K=""
# STRIPE_PRICE_PACK_300K=""

# ─── Phase 4 placeholder — Base L2 / SIWE ────────────────────────────────────
# NEXT_PUBLIC_BASE_RPC_URL=""
# CHAINLINK_PRICE_FEED_ADDRESS=""
