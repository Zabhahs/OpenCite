# OpenCITE — Environment Variables
# Copy to .env.local for local dev. Never commit .env.local.
# Vercel: add all vars via dashboard → Project Settings → Environment Variables.

# ─── Supabase / Prisma ────────────────────────────────────────────────────────
# Get both from: Supabase dashboard → Project Settings → Database → Connection string
#
# DATABASE_URL  — Transaction pooler (port 6543). Used by Prisma at runtime.
#                 Append ?pgbouncer=true to disable prepared statements.
# DIRECT_URL    — Direct connection (port 5432). Used by `prisma migrate` only.

DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ─── Auth.js ──────────────────────────────────────────────────────────────────
# AUTH_SECRET: generate with `openssl rand -base64 32`

AUTH_SECRET=""

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client
# Authorised redirect URI: https://opencite.app/api/auth/callback/google

AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── Apple OAuth ──────────────────────────────────────────────────────────────
# Apple Developer → Certificates, IDs & Profiles → Services IDs
# AUTH_APPLE_SECRET is the generated .p8 key contents (multiline, base64 or raw)
# Redirect URI: https://opencite.app/api/auth/callback/apple

AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# ─── Microsoft Entra ID (formerly Azure AD) ───────────────────────────────────
# Azure Portal → App registrations → your app → Overview
# Redirect URI: https://opencite.app/api/auth/callback/microsoft-entra-id
# TENANT_ID: use "common" for multi-tenant (personal + work accounts)

AUTH_MICROSOFT_ENTRA_ID=""
AUTH_MICROSOFT_ENTRA_SECRET=""
AUTH_MICROSOFT_ENTRA_TENANT_ID="common"

# ─── Phase 3 placeholder — Stripe ────────────────────────────────────────────
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""

# ─── Phase 4 placeholder — Base L2 / SIWE ────────────────────────────────────
