# Admin email(s) for debug tooling + admin console — comma-separated, lowercase.
# Gate: src/lib/admin.js → isAdmin(user). A signed-in user whose Google email is in
# this list sees the ⚗ admin link + can open #/admin/console; everyone else cannot.
# NOTE: this is a VITE_ build-time var — Vite inlines it into the bundle at build.
# Changing it on Vercel requires a REDEPLOY to take effect (the old value is baked in).
VITE_ADMIN_EMAILS=shahbaz.citationtoday@gmail.com,zabhahs11@gmail.com
