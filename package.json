{
  "name": "opencite",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:css": "tailwindcss -i ./src/input.css -o ./public/output.css --watch",
    "build": "node scripts/migrate.mjs; npx tailwindcss -i ./src/input.css -o ./public/output.css --minify && vite build",
    "preview": "vite preview",
    "postinstall": "npx prisma generate",
    "prepare": "node -e \"try{require('child_process').execSync('git config core.hooksPath .githooks')}catch(e){}\""
  },
  "dependencies": {
    "@auth/core": "0.37.4",
    "@auth/prisma-adapter": "2.11.2",
    "@prisma/client": "^6.6.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^17.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "prisma": "^6.6.0",
    "tailwindcss": "^3.4.1",
    "vite": "^5.4.0"
  }
}
