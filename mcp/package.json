{
  "name": "opencite-mcp",
  "version": "0.48.0",
  "private": false,
  "type": "module",
  "description": "MCP server for OpenCITE — verifiable scholarly evidence for agents: verify references before citing them (retracted? fabricated? wrong DOI?), search 250M+ open-access papers plus museum, library, manuscript and Islamicate archives, and fetch any work by DOI/PMID/PMCID with its citation graph. Every card names its source and carries integrity evidence.",
  "license": "MIT",
  "bin": {
    "opencite-mcp": "bin/opencite-mcp.js"
  },
  "exports": {
    ".": "./src/server.js",
    "./tools": "./src/tools.js",
    "./schema": "./src/schema.js"
  },
  "scripts": {
    "start": "node bin/opencite-mcp.js",
    "print-schemas": "node src/tools.js",
    "sync-contract": "node scripts/sync-contract.mjs",
    "prepublishOnly": "npm run sync-contract",
    "check-contract": "node scripts/sync-contract.mjs --check"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "citation-verification",
    "retraction",
    "scholarly-search",
    "open-access",
    "openalex",
    "crossref",
    "pubmed",
    "citations",
    "bibtex",
    "hallucination"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zabhahs/OpenCite.git",
    "directory": "mcp"
  },
  "homepage": "https://citation.today/docs/",
  "files": [
    "bin",
    "src",
    "scripts",
    "README.md",
    "LICENSE"
  ]
}
