{
  "name": "opencite-mcp",
  "version": "0.46.0",
  "private": false,
  "type": "module",
  "description": "MCP server for OpenCITE — one call across 250M+ open-access papers plus museum, library, manuscript and Islamicate archives; deduped, source-labelled, citation-ready (MLA/APA/BibTeX/RIS/CSL-JSON), plus citation-graph traversal and DOI/PMID/PMCID resolution.",
  "license": "MIT",
  "bin": {
    "opencite-mcp": "bin/opencite-mcp.js"
  },
  "exports": {
    ".": "./src/server.js",
    "./schema": "./src/schema.js"
  },
  "scripts": {
    "start": "node bin/opencite-mcp.js",
    "print-schemas": "node src/schema.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "scholarly-search",
    "open-access",
    "openalex",
    "crossref",
    "pubmed",
    "citations",
    "bibtex",
    "europeana",
    "gallica"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Zabhahs/OpenCite.git",
    "directory": "mcp"
  },
  "homepage": "https://citation.today/docs/",
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ]
}
